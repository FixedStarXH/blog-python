BLOG_ENV=development
BLOG_DATABASE_URL=mysql+pymysql://blog:replace-this-password@mysql:3306/blog
BLOG_JWT_SECRET=replace-with-at-least-32-random-bytes
BLOG_SEED_PASSWORD=replace-this-password
BLOG_SEED_USERNAME=site-admin
BLOG_SEED_EMAIL=admin@your-domain.example
MYSQL_PASSWORD=replace-this-password
MYSQL_ROOT_PASSWORD=replace-this-root-password
BLOG_REDIS_URL=redis://redis:6379/0
BLOG_PUBLIC_URL=http://localhost:8080
BLOG_CHAT_BASE_URL=
BLOG_CHAT_API_KEY=
BLOG_CHAT_MODEL=
BLOG_AI_MINUTE_LIMIT=10
BLOG_AI_DAILY_LIMIT=100
BLOG_AI_TIMEOUT_SECONDS=90
BLOG_AI_CONNECT_TIMEOUT_SECONDS=10
BLOG_EMBEDDING_BASE_URL=
BLOG_EMBEDDING_API_KEY=
BLOG_EMBEDDING_MODEL=text-embedding-3-small
BLOG_EMBEDDING_DIMENSION=1536
BLOG_CORS_ORIGINS=http://localhost:5173
BLOG_TRUSTED_PROXY_IPS=127.0.0.1,::1
